{
    "name": "obsidian-proton-drive-sync",
    "version": "0.1.0",
    "description": "Bidirectional sync between an Obsidian vault and Proton Drive, built on the official Proton Drive SDK.",
    "main": "main.js",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit && node esbuild.config.mjs production",
        "check-types": "tsc --noEmit",
        "test": "node scripts/test.mjs"
    },
    "dependencies": {
        "@protontech/crypto": "^2.1.3",
        "@protontech/drive-sdk": "^0.21.1",
        "ky": "^1.14.3"
    },
    "devDependencies": {
        "@types/node": "^22.15.21",
        "builtin-modules": "^4.0.0",
        "esbuild": "^0.25.0",
        "obsidian": "^1.13.1",
        "typescript": "^5.9.3"
    }
}
