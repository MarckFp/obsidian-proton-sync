{
    "name": "obsidian-proton-drive-sync",
    "version": "0.6.0",
    "description": "Bidirectional sync between an Obsidian vault and Proton Drive, built on the official Proton Drive SDK.",
    "main": "main.js",
    "private": true,
    "license": "GPL-3.0-or-later",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit && node esbuild.config.mjs production",
        "check-types": "tsc --noEmit",
        "test": "node scripts/test.mjs",
        "lint": "eslint --max-warnings 0"
    },
    "dependencies": {
        "@protontech/crypto": "^2.1.3",
        "@protontech/drive-sdk": "^0.21.3",
        "core-js": "^3.50.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.4",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "obsidian": "^1.13.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0"
    },
    "homepage": "https://github.com/MarckFp/obsidian-proton-sync",
    "author": "MarckFp",
    "overrides": {
        "moment": "^2.31.0"
    }
}
